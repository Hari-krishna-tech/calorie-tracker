generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  googleId  String    @unique
  avatarUrl String?
  createdAt DateTime  @default(now())
  foodEntries  FoodEntry[]
  settings     Settings[]
  weightEntries WeightEntry[]
  customFoods  Food[]       @relation("CustomFoods")
}

model Food {
  id              String      @id @default(cuid())
  name            String
  category        String
  region          String
  caloriesPerUnit Float
  unitName        String
  servingSizes    String
  isCommon        Boolean     @default(false)
  userId          String?
  createdBy       User?       @relation("CustomFoods", fields: [userId], references: [id])
  createdAt       DateTime    @default(now())
  entries         FoodEntry[]

  @@index([name])
  @@index([userId])
}

model FoodEntry {
  id        String   @id @default(cuid())
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  quantity  Float
  mealType  String
  date      String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Settings {
  id               String @id @default(cuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id])
  dailyCalorieGoal Int    @default(2000)
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weight    Float
  date      String
  createdAt DateTime @default(now())

  @@unique([userId, date])
}
